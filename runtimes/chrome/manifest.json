{
  "manifest_version": 3,
  "name": "Book Props",
  "description": "Obsidian の蔵書の記録と照らして、書店の商品ページで本の所持と購入希望を表示します。",
  "version": "0.5.1",
  "permissions": ["storage", "contextMenus"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' ws://*.localhost:*"
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_title": "Book Props",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/*",
        "https://books.rakuten.co.jp/rb/*",
        "https://www.valuebooks.jp/*",
        "https://shopping.bookoff.co.jp/used/*",
        "https://shopping.bookoff.co.jp/new/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
